# Flask Configuration
FLASK_DEBUG=True

# Secret Key untuk session encryption
# Untuk production: Ganti dengan string yang lebih aman dan random
SECRET_KEY=your-super-secret-key-change-in-production

# Upload Configuration
# 5 MB dalam bytes
MAX_FILE_SIZE=5242880
UPLOAD_FOLDER=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Application Settings
APP_NAME=Aplikasi Koreksi Tanda Baca
APP_VERSION=1.0.0

# Database
DATABASE_URL=mysql+pymysql://user_koreksi:sandiuser_koreksi1%25@localhost:3306/db_koreksi?charset=utf8mb4

# Stanza
STANZA_LANG=id
STANZA_DIR=models/stanza
STANZA_AUTO_DOWNLOAD=1

# POS
POS_BATCH_SIZE=0

# Debug
DEBUG_SAVE=False
